    "method": "POST",
    "path": "/api/v1/login",
    "operation": {
      "summary": "Login",
      "responses": {
        "200": {
          "description": "Valid credentials return a session or challenge_required with an opaque pending challenge. Pending challenges contain no access or refresh token."
        },
        "401": {
          "description": "Unauthenticated"
        },
        "422": {
          "description": "Validation error"
        }
      },
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "email",
                "password"
              ],
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email",
                  "maxLength": 190
                },
                "password": {
                  "type": "string",
                  "maxLength": 255
                },
                "device_id": {
                  "type": "string",
                  "maxLength": 120
                },
                "device_name": {
                  "type": "string",
                  "maxLength": 120
                },
                "device_proof": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "Account-bound secure-storage proof, never a public device ID."
                }
              }
            }
          }
        }
      }
    },
    "disposition": "Obsolete advertised operation; not a current server route. Historical only, not a supported alias."
