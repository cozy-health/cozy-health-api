# Non-secret overrides for the isolated Railway DEVELOPMENT environment only.
# Keep existing unique staging APP_KEY, DB credentials and mail-sink credentials.
AGE_ENFORCEMENT_ENABLED=false
GUARDIAN_INVITATIONS_ENABLED=false
AGE_HEALTH_DATA_READY=false
MINOR_APPROVED_COUNTRIES=
GUARDIAN_ASSURANCE_APPROVAL=
GUARDIAN_RETENTION_APPROVAL=
GUARDIAN_RECORD_DAYS=0
AGE_CORRECTION_PROCEDURE_APPROVAL=
GUARDIAN_REVIEWER_IDS=
