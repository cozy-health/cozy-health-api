APP_NAME="Cozy Health API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# Production requires a mounted trusted CA and a TLS-capable MySQL endpoint.
# Temporary production opt-out is owner-approved until Phase 24 CA provisioning.
DB_TLS_ENFORCE=true
# Local development does not require MySQL TLS.
DB_REQUIRE_TLS=false
MYSQL_SSL_CA=
DB_PORT=3306
DB_DATABASE=cozy_health
DB_USERNAME=root
DB_PASSWORD=
DB_URL=
DB_SOCKET=
DB_CONNECTION_TIMEOUT=5

# Reserved only: no pool implementation or query timeout consumes these keys.
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_WAIT_TIMEOUT=5
DB_QUERY_TIMEOUT=30

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
MAIL_MAILER=log
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

APPLE_SERVICE_ID=
APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Only needed when the Apple web authorization request uses a redirect URI.
APPLE_REDIRECT_URI=

# Brevo transactional webhook bearer token (random, at least 32 characters)
BREVO_WEBHOOK_TOKEN=

# Provider destruction remains disabled until a signed retention policy exists.
PROVIDER_RETENTION_APPROVAL=
PROVIDER_ACCESS_LOG_DAYS=
PROVIDER_RETENTION_GLOBAL_HOLD=false
PROVIDER_RETENTION_HELD_PROVIDER_IDS=

# Enable only after Firebase setup and device acceptance. iOS remains off for unsigned sideload builds.
PUSH_ENABLED=false
PUSH_IOS_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
# Alternative for managed hosting: store the service-account JSON in a secret environment variable.
FIREBASE_CREDENTIALS_JSON=
# Set false for the API when a dedicated queue-worker service already exists.
RUN_QUEUE_WORKER=true

# Link used in patient invitation emails
PROVIDER_PORTAL_URL=https://v0-provider-dashboard-component-production.up.railway.app/provider

# Private Railway profile-photo bucket (backend only; never put keys in the app).
AVATAR_BUCKET=
AVATAR_ENDPOINT=
AVATAR_REGION=auto
AVATAR_ACCESS_KEY_ID=
AVATAR_SECRET_ACCESS_KEY=
AVATAR_USE_PATH_STYLE_ENDPOINT=false

# Voice audio: private storage only. Local storage needs a persistent volume in production.
AUDIO_FILESYSTEM_DISK=local
AUDIO_FFMPEG_BINARY=ffmpeg
AUDIO_FFPROBE_BINARY=ffprobe

# Age/guardian rollout: keep disabled until compatible clients and approvals exist.
AGE_ENFORCEMENT_ENABLED=false
GUARDIAN_INVITATIONS_ENABLED=false
AGE_HEALTH_DATA_READY=false
MINOR_APPROVED_COUNTRIES=
GUARDIAN_ASSURANCE_APPROVAL=
GUARDIAN_RETENTION_APPROVAL=
GUARDIAN_RECORD_DAYS=0
GUARDIAN_REVIEWER_IDS=
AGE_CORRECTION_PROCEDURE_APPROVAL=
GUARDIAN_WEBSITE_URL=https://cozyhealth.org
