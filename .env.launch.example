# Merge into the deployment environment; never commit real credentials.
# All release features stay off until their operational acceptance checks pass.
STORE_BILLING_ENABLED=false
# Product ID => {"platform":"apple|google","tier":"premium|student","interval":"monthly|yearly"}
STORE_PRODUCTS_JSON={}
APPLE_STORE_ISSUER_ID=
APPLE_STORE_KEY_ID=
APPLE_STORE_PRIVATE_KEY=
APPLE_STORE_BUNDLE_ID=
APPLE_STORE_SANDBOX=true
# Path to the independently obtained official Apple root certificate bundle.
APPLE_STORE_ROOT_CA=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_WEBHOOK_AUDIENCE=
GOOGLE_PLAY_WEBHOOK_EMAIL=
STUDENT_REVIEW_ENABLED=false
# Review and approve this schedule before enabling evidence uploads.
STUDENT_EVIDENCE_RETENTION_DAYS=30
EMERGENCY_EMAIL_ENABLED=false
# Zero disables sending. Count confirmation requests and alert attempts together.
EMERGENCY_EMAIL_DAILY_LIMIT=0
# Production mail and a durable queue must be configured and verified separately.
